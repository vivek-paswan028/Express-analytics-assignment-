# ─────────────────────────────────────────────────────────────────
# RAG Documentation Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── LLM Provider (required) ──────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── LLM Configuration ────────────────────────────────────────────
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0

# ── Embedding Model ───────────────────────────────────────────────
# Local model — no API key needed. Downloaded once from HuggingFace.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ─────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# ── Retrieval Settings ────────────────────────────────────────────
RETRIEVAL_TOP_K=5
MAX_RETRIES=2               # Max query-rewrite + re-retrieval attempts

# ── Ingestion Settings ────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=5

# ── FastAPI ───────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ── Feedback Storage ──────────────────────────────────────────────
FEEDBACK_LOG_PATH=./data/feedback.jsonl

# ── Optional: Web Search Fallback (Bonus Feature) ─────────────────
# TAVILY_API_KEY=your_tavily_key_here

